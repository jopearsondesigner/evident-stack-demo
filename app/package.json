{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidentsystems/platform.git"
  },
  "author": "Evident Systems LLC",
  "bugs": {
    "url": "https://github.com/evidentsystems/platform/issues"
  },
  "homepage": "https://github.com/evidentsystems/platform/tree/main/app#readme",
  "scripts": {
    "app:dev": "vite dev",
    "app:build": "vite build",
    "state:dev": "cd state && cargo watch -i .gitignore -i \"pkg/*\" -s \"wasm-pack build --target web\"",
    "state:build": "cd state && wasm-pack build --target web --release",
    "dev": "concurrently -k \"npm:state:dev\" \"npm:app:dev\"",
    "preview": "vite preview",
    "build": "npm run state:build && npm run app:build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "playwright test",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write ."
  },
  "devDependencies": {
    "@marplex/flarebase-auth": "^1.2.0",
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-cloudflare": "2.1.0",
    "@sveltejs/kit": "^1.14.0",
    "@tailwindcss/typography": "^0.5.8",
    "@types/dompurify": "^2.4.0",
    "@types/uuid": "^9.0.1",
    "app-state": "0.1.0",
    "autoprefixer": "^10.4.13",
    "classnames": "^2.3.2",
    "concurrently": "^6.3.0",
    "daisyui": "^2.41.0",
    "dexie": "^3.2.3",
    "dompurify": "^2.4.3",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "firebase": "^9.18.0",
    "postcss": "^8.4.19",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "svelte": "^3.57.0",
    "svelte-accessible-accordion": "^2.1.0",
    "svelte-check": "^2.9.2",
    "svelte-highlight": "^7.2.1",
    "svelte-layout-aware-transitions": "^0.0.5",
    "svelte-markdown": "^0.2.3",
    "svelte-prism": "^1.1.6",
    "tailwindcss": "^3.3.0",
    "typescript": "^4.9.3",
    "uuid": "^9.0.0",
    "vite": "^4.0.0",
    "vite-plugin-top-level-await": "^1.2.2",
    "vite-plugin-wasm": "^3.1.1",
    "vitest": "^0.25.3"
  }
}
