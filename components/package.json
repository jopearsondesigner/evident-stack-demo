{
  "name": "components",
  "version": "0.1.0",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "build-watch": "svelte-kit sync && svelte-package --watch",
    "prepublishOnly": "echo 'Did you mean to publish `./package/`, instead of `./`?' && exit 1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "playwright test",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "storybook": "storybook dev -p 6012",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=ef524e4bbd6c"
  },
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@playwright/test": "^1.28.1",
    "@storybook/addon-essentials": "next",
    "@storybook/addon-interactions": "next",
    "@storybook/addon-links": "next",
    "@storybook/addon-svelte-csf": "next",
    "@storybook/blocks": "next",
    "@storybook/svelte": "next",
    "@storybook/sveltekit": "next",
    "@storybook/testing-library": "next",
    "@storybook/theming": "next",
    "@sveltejs/adapter-cloudflare": "2.1.0",
    "@sveltejs/package": "^1.0.0",
    "@sveltejs/kit": "^1.14.0",
    "@tailwindcss/typography": "^0.5.8",
    "@types/dompurify": "^2.4.0",
    "autoprefixer": "^10.4.13",
    "classnames": "^2.3.2",
    "chromatic": "^6.13.1",
    "daisyui": "^2.41.0",
    "dompurify": "^2.4.3",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-storybook": "^0.6.8",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.19",
    "postcss-cli": "^10.1.0",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "next",
    "svelte": "^3.54.0",
    "svelte-check": "^2.9.2",
    "svelte-layout-aware-transitions": "^0.0.5",
    "svelte-markdown": "^0.2.3",
    "tailwindcss": "^3.3.0",
    "tslib": "^2.4.1",
    "typescript": "^4.9.3",
    "vite": "^4.0.0",
    "vitest": "^0.25.3"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "svelte-layout-aware-transitions": "^0.0.5",
    "svelte-accessible-accordion": "^2.1.0"
  },
  "description": "Everything you need to build a Svelte project, powered by [`create-svelte`](https://github.com/sveltejs/kit/tree/master/packages/create-svelte).",
  "main": "playwright.config.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidentsystems/platform.git"
