{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidentsystems/platform.git"
  },
  "author": "Evident Systems LLC",
  "bugs": {
    "url": "https://github.com/evidentsystems/platform/issues"
  },
  "homepage": "https://github.com/evidentsystems/platform/tree/main/app#readme",
  "scripts": {
    "app:dev": "vite dev",
    "app:build": "vite build",
    "state:dev": "cd state && cargo watch -i .gitignore -i \"pkg/*\" -s \"wasm-pack build --target web\"",
    "state:build": "cd state && wasm-pack build --target web",
    "dev": "concurrently --kill-others-on-fail \"npm run state:dev\" \"npm run app:dev\"",
    "preview": "npm run state:build && vite preview",
    "build": "npm run state:build && npm run app:build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "playwright test",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "release": "npm run state:build && npm run check && npm run test && npm run app:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-cloudflare": "^1.0.0",
    "@sveltejs/kit": "^1.0.0",
    "@tailwindcss/typography": "^0.5.8",
    "@types/dompurify": "^2.4.0",
    "autoprefixer": "^10.4.13",
    "concurrently": "^6.3.0",
    "daisyui": "^2.41.0",
    "dompurify": "^2.4.3",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.19",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "svelte": "^3.54.0",
    "svelte-check": "^2.9.2",
    "svelte-markdown": "^0.2.3",
    "tailwindcss": "^3.2.4",
    "typescript": "^4.9.3",
    "vite": "^4.0.0",
    "vite-plugin-top-level-await": "^1.2.2",
    "vite-plugin-wasm": "^3.1.1",
    "vitest": "^0.25.3"
  },
  "dependencies": {
    "editor-state": "0.1.0"
  }
}
