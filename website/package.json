{
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidentsystems/platform.git"
  },
  "author": "Evident Systems LLC",
  "bugs": {
    "url": "https://github.com/evidentsystems/platform/issues"
  },
  "homepage": "https://github.com/evidentsystems/platform/tree/main/website#readme",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "playwright test",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-cloudflare": "2.1.0",
    "@sveltejs/kit": "^1.14.0",
    "@tailwindcss/typography": "^0.5.8",
    "autoprefixer": "^10.4.13",
    "daisyui": "^2.41.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.19",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "svelte": "^3.54.0",
    "svelte-check": "^2.9.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^4.9.3",
    "vite": "^4.0.0",
    "vitest": "^0.25.3"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "components": "0.1.0",
    "svelte-layout-aware-transitions": "^0.0.5",
    "svelte-use-click-outside": "^1.0.0"
  }
}
