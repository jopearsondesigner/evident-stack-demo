{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidentsystems/platform.git"
  },
  "author": "Evident Systems LLC",
  "bugs": {
    "url": "https://github.com/evidentsystems/platform/issues"
  },
  "homepage": "https://github.com/evidentsystems/platform/tree/main/app#readme",
  "scripts": {
    "app:dev": "vite dev",
    "app:build": "vite build",
    "state:dev": "cd state && cargo watch -i .gitignore -i \"pkg/*\" -s \"wasm-pack build --dev --target web\"",
    "state:build": "cd state && wasm-pack build --release --target web",
    "db:types": "npx supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "dev": "concurrently -k \"npm:state:dev\" \"npm:app:dev\"",
    "preview": "vite preview",
    "build": "npm run state:build && npm run app:build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "playwright test",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write ."
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.1.7",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@lottiefiles/svelte-lottie-player": "^0.3.0",
    "@playwright/test": "^1.28.1",
    "@sagi.io/workers-jwt": "^0.0.23",
    "@supabase/auth-helpers-sveltekit": "^0.9.4",
    "@supabase/auth-ui-shared": "^0.1.3",
    "@supabase/auth-ui-svelte": "^0.1.5",
    "@supabase/supabase-js": "^2.21.0",
    "@sveltejs/adapter-cloudflare": "2.1.0",
    "@sveltejs/kit": "^1.16.3",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.59",
    "@tailwindcss/typography": "^0.5.8",
    "@types/dompurify": "^2.4.0",
    "@types/uuid": "^9.0.1",
    "autoprefixer": "^10.4.13",
    "base64-js": "^1.5.1",
    "classnames": "^2.3.2",
    "codemirror": "^6.0.1",
    "concurrently": "^6.3.0",
    "daisyui": "^2.41.0",
    "dexie": "^3.2.3",
    "dexie-observable": "^4.0.1-beta.13",
    "dexie-syncable": "^4.0.1-beta.13",
    "dompurify": "^2.4.3",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.19",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "state-client": "0.1.0",
    "supabase": "^1.57.3",
    "svelte": "^3.57.0",
    "svelte-accessible-accordion": "^2.1.0",
    "svelte-check": "^2.9.2",
    "svelte-codemirror-editor": "^1.1.0",
    "svelte-highlight": "^7.2.1",
    "svelte-markdown": "^0.2.3",
    "svelte-prism": "^1.1.6",
    "tailwindcss": "^3.3.0",
    "typescript": "^4.9.3",
    "uuid": "^9.0.0",
    "vite": "^4.3.0",
    "vite-plugin-top-level-await": "^1.2.2",
    "vite-plugin-wasm": "^3.1.1",
    "vitest": "^0.25.3"
  }
}
